server {
    listen 80;
    server_name xingmo.example.com;

    # Browser traffic reaches only the StarDevil facade, never NewAPI directly.
    location / {
        proxy_pass http://xingmo-server:5178;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }
}
